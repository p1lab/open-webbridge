{
  "manifest_version": 3,
  "name": "OpenWebBridge",
  "version": "1.0.0",
  "description": "Open source bridge connecting AI agents with your real browser",
  "permissions": [
    "tabs",
    "tabGroups",
    "debugger",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenWebBridge Control Panel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
